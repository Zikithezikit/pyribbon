from collections.abc import Iterable
from typing import final

from typing_extensions import Buffer, Self

_Key = bytes | bytearray | memoryview | str | int

class RibbonError(Exception): ...
class ConstructionError(RibbonError): ...
class FormatError(RibbonError, ValueError): ...

@final
class RibbonFilter:
    def __new__(
        cls,
        keys: Iterable[_Key] | Buffer,
        *,
        fp_bits: int = 8,
        seed: int = 0,
        overhead: float | None = None,
        max_attempts: int = 32,
    ) -> Self: ...
    def __contains__(self, key: _Key, /) -> bool: ...
    def __len__(self) -> int: ...
    def contains_many(self, keys: Iterable[_Key] | Buffer, /) -> list[bool]: ...
    def to_bytes(self) -> bytes: ...
    @classmethod
    def from_buffer(cls, buffer: Buffer, *, verify: bool = True) -> Self: ...
    def __reduce__(self) -> tuple[object, tuple[bytes]]: ...
    @property
    def size_in_bytes(self) -> int: ...
    @property
    def bits_per_key(self) -> float: ...
    @property
    def fp_bits(self) -> int: ...
